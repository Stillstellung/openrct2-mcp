{
  "mcpServers": {
    "openrct2": {
      "type": "stdio",
      "command": "C:\\path\\to\\openrct2-mcp\\.venv\\Scripts\\python.exe",
      "args": ["-m", "openrct2_mcp"],
      "env": {
        "PYTHONUTF8": "1",
        "OPENRCT2_BRIDGE_PORT": "20020",
        "OPENRCT2_RIDE_BUILDER_PORT": "20021"
      }
    }
  }
}
